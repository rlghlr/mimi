# Muse — environment variables
# Copy to .env.local and fill with your Supabase project values.
# For local dev, `npm run db:start` prints the local URL + anon key.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only. Never expose to the client. Used by Admin + server actions.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
